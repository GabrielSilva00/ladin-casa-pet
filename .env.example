# ─────────────────────────────────────────────────────────────
# Cabana Pet Café — variáveis de ambiente
# Copie para .env.local (local) ou cole na Vercel (produção).
# ─────────────────────────────────────────────────────────────

# ── MODO WHATSAPP-ONLY (default, sem banco) ─────────────────
# Para começar, SÓ esta é necessária:
NEXT_PUBLIC_SITE_URL=https://cabanapetcafe.vercel.app

# Nada mais abaixo é obrigatório. O agendamento abre o WhatsApp do
# estabelecimento com a mensagem pronta — o tutor toca enviar e você
# confirma manualmente. A landing e o fluxo rodam 100% sem banco.

# ── LIGAR O PAINEL ADMIN (quando quiser) ────────────────────
# Assim que estas 3 variáveis existirem, o painel em /admin ativa
# automaticamente e os agendamentos passam a ser salvos no banco
# + ainda abrem no WhatsApp.
# https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# E-mails liberados para entrar no /admin (separados por vírgula)
ADMIN_ALLOWED_EMAILS=oficialdevblack@gmail.com

# ── LIGAR CONFIRMAÇÕES AUTOMÁTICAS (opcional) ───────────────
# WhatsApp Z-API — dispara a confirmação para o TUTOR após o save
# https://z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_FROM_NUMBER=551931991405

# E-mail Resend — envia confirmação em HTML editorial para o tutor
# https://resend.com
RESEND_API_KEY=
RESEND_FROM="Cabana Pet Café <ola@cabanapetcafe.com.br>"

# ── OPCIONAIS ───────────────────────────────────────────────
# Google Calendar (service account) — bloqueia horários no calendário real
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CALENDAR_ID=

# Mapbox — troca o SVG estilizado por um mapa interativo custom
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=

# Analytics sem cookies, LGPD-friendly
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
