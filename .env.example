# ─────────────────────────────────────────────────────────────
# Cabana Pet Café — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Dashboard: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=xxxxxx

# ── WhatsApp (Z-API Brasil) ─────────────────────────────────
# https://z-api.io — instancia + token + client-token
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_FROM_NUMBER=551931991405

# ── Email (Resend) ──────────────────────────────────────────
# https://resend.com/api-keys — domínio verificado em DNS
RESEND_API_KEY=
RESEND_FROM="Cabana Pet Café <ola@cabanapetcafe.com.br>"

# ── Google Calendar ─────────────────────────────────────────
# Service Account JSON (base64) + e-mail do calendário do estabelecimento
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_CALENDAR_ID=cabanapetcafe@group.calendar.google.com

# ── Mapbox ──────────────────────────────────────────────────
# https://account.mapbox.com — token público com escopo styles:read
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/cabana/clxxxxxxx

# ── Analytics (Plausible) ───────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=cabanapetcafe.com.br

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cabanapetcafe.com.br
ADMIN_ALLOWED_EMAILS=lucas@cabanapetcafe.com.br
